---
/**
 * Base layout: <head> with full SEO metadata, hreflang, Open Graph, Twitter
 * card and JSON-LD; skip link; header; page content; footer; mobile bar;
 * and the single behaviour script.
 */
import "@/styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import MobileBar from "@/components/MobileBar.astro";
import { brandName, contact, siteUrl } from "../../site.config.mjs";
import { getDictionary, localePath, localeTags, locales, type Locale, type RouteKey } from "@/i18n";
import ogDefault from "@/assets/images/camp-football-1.jpeg";

interface Props {
  locale: Locale;
  current: RouteKey;
  title: string;
  description: string;
  /** Page-specific share image (imported asset). Falls back to an owned camp photo. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Extra JSON-LD objects to append to the organisation graph. */
  schema?: Record<string, unknown>[];
  /** Hide the sticky mobile CTA bar (used on the contact page). */
  hideMobileBar?: boolean;
}

const { locale, current, title, description, ogImage, ogImageAlt, schema = [], hideMobileBar = false } = Astro.props;
const t = getDictionary(locale);
const tags = localeTags[locale];

const abs = (path: string) => new URL(path, siteUrl).href;
const canonical = abs(localePath(locale, current));

const share = await getImage({ src: ogImage ?? ogDefault, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 });
const shareUrl = abs(share.src);
const shareAlt = ogImageAlt ?? t.home.hero.imageAlt;

const organisation = {
  "@type": ["SportsOrganization", "LocalBusiness"],
  "@id": abs("/#organization"),
  name: brandName,
  url: abs("/"),
  logo: abs("/icon-512.png"),
  image: shareUrl,
  description: t.meta.tagline,
  email: contact.email,
  telephone: contact.phones.map((p) => p.display),
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressCountry: contact.address.countryCode,
  },
  areaServed: { "@type": "Country", name: "Cyprus" },
  knowsAbout: ["Sambo", "Judo", "Football training camps", "Sports training camps", "Sports event organisation"],
  sameAs: [contact.social.instagram, contact.social.tiktok],
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "sales",
      telephone: contact.phones[0].display,
      email: contact.email,
      areaServed: "CY",
      availableLanguage: ["English", "Greek", "Russian"],
    },
  ],
};

const webPage = {
  "@type": "WebPage",
  "@id": canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: tags.lang,
  isPartOf: { "@id": abs("/#website") },
  about: { "@id": abs("/#organization") },
  primaryImageOfPage: shareUrl,
};

const webSite = {
  "@type": "WebSite",
  "@id": abs("/#website"),
  url: abs("/"),
  name: brandName,
  publisher: { "@id": abs("/#organization") },
  inLanguage: locales.map((l) => localeTags[l].lang),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organisation, webSite, webPage, ...schema],
};
---

<!doctype html>
<html lang={tags.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={localeTags[l].hreflang} href={abs(localePath(l, current))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(localePath("en", current))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content={tags.og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeTags[l].og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="twitter:image:alt" content={shareAlt} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a1322" />
    <meta name="color-scheme" content="light" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={{ "has-mobile-bar": !hideMobileBar }}>
    <a class="skip-link" href="#main-content">{t.common.skipToContent}</a>
    <Header locale={locale} current={current} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} current={current} />
    {!hideMobileBar && <MobileBar locale={locale} />}
    <script src="@/scripts/main.js"></script>
  </body>
</html>
