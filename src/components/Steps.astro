---
/**
 * "How it works" steps: a horizontal progression with large numerals and a
 * connecting rule.
 */
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((step, i) => (
      <li class="steps__item reveal" data-delay={String(Math.min(i, 3))}>
        <span class="steps__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="steps__title">{step.title}</h3>
        <p class="steps__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
    counter-reset: step;
  }

  .steps__item {
    position: relative;
    padding-top: var(--s-5);
    border-top: 2px solid var(--c-line);
  }

  .steps__item::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--c-turq);
  }

  .steps__num {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--c-line-strong);
    margin-bottom: var(--s-3);
  }

  .steps__title {
    font-size: 1.4rem;
    margin-bottom: var(--s-2);
  }

  .steps__text {
    color: var(--c-muted);
  }

  :global(.section--dark) .steps__item {
    border-top-color: var(--c-line-on-dark);
  }

  :global(.section--dark) .steps__num {
    color: rgba(255, 255, 255, 0.28);
  }

  :global(.section--dark) .steps__text {
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
