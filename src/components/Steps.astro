---
/**
 * "How it works" steps: a horizontal progression with large numerals and a
 * connecting rule.
 */
interface Props {
  steps: { title: string; text: string }[];
  /**
   * "line": all steps hang from one continuous rule with dot markers.
   * "giant": oversized outlined numerals as graphic elements (home page).
   */
  variant?: "default" | "line" | "giant";
}

const { steps, variant = "default" } = Astro.props;
---

<ol class:list={["steps", { "steps--line": variant === "line", "steps--giant": variant === "giant" }]}>
  {
    steps.map((step, i) => (
      <li class="steps__item reveal" data-delay={String(Math.min(i, 3))}>
        <span class="steps__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="steps__title">{step.title}</h3>
        <p class="steps__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
    counter-reset: step;
  }

  .steps__item {
    position: relative;
    padding-top: var(--s-5);
    border-top: 2px solid var(--c-line);
  }

  .steps__item::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: var(--c-turq);
  }

  .steps__num {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--c-line-strong);
    margin-bottom: var(--s-3);
  }

  .steps__title {
    font-size: 1.4rem;
    margin-bottom: var(--s-2);
  }

  .steps__text {
    color: var(--c-muted);
  }

  /* Line variant: one continuous rule, dot markers, smaller numerals */
  .steps--line {
    gap: 0 var(--s-6);
  }

  .steps--line .steps__item {
    border-top: 1px solid var(--c-line-strong);
    padding-top: var(--s-6);
    padding-right: var(--s-4);
  }

  .steps--line .steps__item::before {
    top: -5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-turq);
  }

  .steps--line .steps__num {
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    color: var(--c-turq-700);
  }

  .steps--line .steps__title {
    font-size: 1.5rem;
  }

  /* Giant variant: outlined cyan numerals, uppercase titles, one rule */
  .steps--giant {
    gap: 0 var(--s-6);
  }

  .steps--giant .steps__item {
    border-top: 1px solid var(--c-line-strong);
    padding-top: var(--s-5);
  }

  .steps--giant .steps__item::before {
    width: 2.5rem;
  }

  .steps--giant .steps__num {
    font-size: clamp(4rem, 7vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--c-cyan);
    margin-bottom: var(--s-4);
  }

  .steps--giant .steps__title {
    font-size: 1.45rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  :global(.section--dark) .steps__item {
    border-top-color: var(--c-line-on-dark);
  }

  :global(.section--dark) .steps__num {
    color: rgba(255, 255, 255, 0.28);
  }

  :global(.section--dark) .steps__text {
    color: var(--c-on-dark-muted);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps--line .steps__item {
      padding-top: var(--s-5);
      padding-bottom: var(--s-4);
    }
  }
</style>
