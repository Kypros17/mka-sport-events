---
/**
 * Home hero, composed like the reference: a compact full-bleed photograph
 * with a dark navy overlay on the left, a label line, the italic headline
 * with the destination in cyan, a thin tracked promise line, two buttons,
 * and the benefit strip inside the hero. Right edge: a small stacked tagline
 * and the location. The header overlays this section.
 */
import { Picture } from "astro:assets";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Streaks from "./Streaks.astro";
import { getDictionary, localePath, type Locale } from "@/i18n";
import heroImg from "@/assets/images/camp-football-1.jpeg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const h = t.home.hero;
const icons = ["plane", "sun", "stadium", "trophy"] as const;
---

<section class="hero" id="hero">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={heroImg}
      alt=""
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <p class="sr-only">{h.imageAlt}</p>
  <Streaks side="left" />

  <div class="container container--wide hero__inner">
    <div class="hero__copy">
      <ul class="label-line" aria-label={h.labelsLabel}>
        {h.labels.map((l) => <li>{l}</li>)}
      </ul>

      <h1 class="hero__title display display--it">
        <span class="hero__l1">{h.line1}</span>
        <span class="hero__l2">
          {h.line2a} <span class="display__accent">{h.line2b}</span>
        </span>
      </h1>
      <p class="tracked hero__l3">{h.line3}</p>

      <div class="hero__actions">
        <Button href={localePath(locale, "contact")} variant="primary" icon="arrow" track="offer">
          {t.common.requestOffer}
        </Button>
        <Button href="#services" variant="ghost">
          {h.ctaExplore}
        </Button>
      </div>

      <ul class="hero__benefits" aria-label={h.benefitsLabel}>
        {
          h.benefits.map((b, i) => (
            <li class="hero__benefit">
              <span class="hero__benefit-icon"><Icon name={icons[i]} /></span>
              <span class="hero__benefit-title">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__side" aria-hidden="true">
      <p class="stack-tag">
        {h.tagline.map((w) => <span>{w}</span>)}
      </p>
      <p class="hero__location">
        {h.location.split(",").map((part) => <span>{part.trim()}</span>)}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 66vh, 720px);
    display: grid;
    color: #fff;
    background-color: var(--c-ink-950);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: 70% 30%;
    filter: contrast(1.05) saturate(1.12);
    animation: hero-settle 12s var(--ease) both;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 18, 32, 0.96) 0%, rgba(8, 18, 32, 0.88) 34%, rgba(8, 18, 32, 0.45) 58%, rgba(8, 18, 32, 0.08) 100%),
      linear-gradient(180deg, rgba(5, 11, 20, 0.55) 0%, rgba(5, 11, 20, 0) 30%, rgba(5, 11, 20, 0.35) 100%);
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-6);
    padding-top: calc(var(--header-h) + clamp(1.5rem, 3vw, 2.5rem));
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hero__copy {
    display: grid;
    gap: var(--s-4);
    align-content: end;
    max-width: 60rem;
  }

  .hero__title {
    display: grid;
    font-size: clamp(2.6rem, 5.6vw, 5.2rem);
    line-height: 0.9;
    color: #fff;
    padding-right: 0.15em; /* keep italic overhang inside the box */
  }

  .hero__l1,
  .hero__l2 {
    display: block;
  }

  .hero__l3 {
    margin-top: 0.1rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  /* Benefit strip inside the hero */
  .hero__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem clamp(1.2rem, 3vw, 2.6rem);
    margin-top: var(--s-4);
  }

  .hero__benefit {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .hero__benefit-icon {
    display: inline-flex;
    color: var(--c-cyan);
  }

  .hero__benefit-icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .hero__benefit-title {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.2;
    max-width: 14ch;
    overflow-wrap: anywhere;
  }

  /* Right edge: stacked tagline and location */
  .hero__side {
    display: grid;
    gap: var(--s-7);
    justify-items: end;
    align-content: end;
    text-align: right;
    padding-bottom: 0.4rem;
  }

  .hero__side .stack-tag {
    justify-items: end;
  }

  .hero__location {
    display: grid;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__side {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 0;
    }

    .hero__media :global(img) {
      object-position: 68% 28%;
    }

    .hero__media::after {
      background:
        linear-gradient(180deg, rgba(5, 11, 20, 0.65) 0%, rgba(5, 11, 20, 0.15) 26%, rgba(5, 11, 20, 0.75) 52%, rgba(5, 11, 20, 0.98) 100%);
    }

    .hero__inner {
      padding-top: calc(var(--header-h) + 44vw);
      padding-bottom: var(--s-5);
    }

    .hero__title {
      font-size: clamp(2.7rem, 13.5vw, 4.2rem);
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }

    .hero__benefits {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem 1rem;
      padding-top: var(--s-4);
      border-top: 1px solid var(--c-line-on-dark);
    }

    .hero__benefit-title {
      max-width: none;
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) {
      animation: none;
    }
  }
</style>
