---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import logo from "@/assets/images/logo-mark.png";
import { brandName } from "../../site.config.mjs";
import { getDictionary, localePath, type Locale, type RouteKey } from "@/i18n";
import { whatsappLink } from "@/lib/links";

interface Props {
  locale: Locale;
  current: RouteKey;
  /**
   * "overlay": transparent over the page hero, turning solid once the hero
   * scrolls away (home page). "solid": always solid (inner pages).
   */
  variant?: "solid" | "overlay";
}

const { locale, current, variant = "solid" } = Astro.props;
const t = getDictionary(locale);
const other: Locale = locale === "en" ? "ru" : "en";

const navItems: { key: RouteKey; label: string }[] = [
  { key: "about", label: t.nav.about },
  { key: "camps", label: t.nav.camps },
  { key: "events", label: t.nav.events },
  { key: "facilities", label: t.nav.facilities },
  { key: "contact", label: t.nav.contact },
];
---

<header class:list={["site-header", { "site-header--overlay": variant === "overlay" }]} id="site-header" data-variant={variant}>
  <div class="container container--wide header-inner">
    <a href={localePath(locale, "home")} class="brand" aria-label={`${brandName} — ${t.common.home}`}>
      <Image src={logo} alt="" width="88" height="88" class="brand__mark" loading="eager" />
      <span class="brand__name" aria-hidden="true">
        <span class="brand__mka">MKA</span>
        <span class="brand__rest"><span class="brand__sport">sport</span> Events</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={t.common.mainNavigation}>
      <ul class="site-nav__list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={localePath(locale, item.key)}
                class:list={["site-nav__link", { "is-current": item.key === current }]}
                aria-current={item.key === current ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__extras">
        <Button href={localePath(locale, "contact")} variant="primary" track="offer" size="sm">
          {t.common.requestOffer}
        </Button>
        <a class="site-nav__whatsapp" href={whatsappLink(locale)} target="_blank" rel="noopener" data-track="whatsapp">
          <Icon name="whatsapp" />
          <span>{t.common.chatOnWhatsapp}</span>
        </a>
        <a class="site-nav__lang" href={localePath(other, current)} hreflang={other} lang={other}>
          {t.common.switchTo}
        </a>
      </div>
    </nav>

    <div class="header-tools">
      <a
        class="tool tool--whatsapp"
        href={whatsappLink(locale)}
        target="_blank"
        rel="noopener"
        aria-label={t.common.chatOnWhatsapp}
        title={t.common.whatsapp}
        data-track="whatsapp"
      >
        <Icon name="whatsapp" />
      </a>
      <a class="tool tool--lang" href={localePath(other, current)} hreflang={other} lang={other} aria-label={t.common.switchTo} title={t.common.switchTo}>
        {t.common.switchToShort}
      </a>
      <div class="header-cta">
        <Button href={localePath(locale, "contact")} variant="primary" size="sm" track="offer">
          {t.common.requestOffer}
        </Button>
      </div>
      <button
        type="button"
        class="tool nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={t.common.openMenu}
        data-label-open={t.common.openMenu}
        data-label-close={t.common.closeMenu}
      >
        <Icon name="menu" class="nav-toggle__open" />
        <Icon name="close" class="nav-toggle__close" />
      </button>
    </div>
  </div>
</header>

<style>
  /* Dark header on every page; the overlay variant starts transparent */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-ink-950);
    color: #fff;
    border-bottom: 1px solid rgba(31, 177, 210, 0.25);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-4);
    min-height: var(--header-h);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    min-height: 44px;
  }

  .brand__mark {
    width: 42px;
    height: 42px;
    border-radius: 4px;
  }

  .brand__name {
    display: grid;
    font-family: var(--font-display);
    line-height: 1;
    color: #fff;
    white-space: nowrap;
  }

  .brand__mka {
    font-size: 1.45rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .brand__rest {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .brand__sport {
    color: var(--c-cyan);
  }

  /* Desktop nav, centred */
  .site-nav {
    justify-self: center;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    position: relative;
    transition: color var(--dur) var(--ease);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 7px;
    height: 2px;
    background: var(--c-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .site-nav__link:hover,
  .site-nav__link.is-current {
    color: #fff;
  }

  .site-nav__link.is-current::after {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav__link:hover::after {
      transform: scaleX(1);
    }
  }

  .site-nav__extras {
    display: none;
  }

  /* Tools */
  .header-tools {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    color: #fff;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .tool:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .tool--whatsapp {
    border-radius: 50%;
    border: 1.5px solid var(--c-cyan);
    color: var(--c-cyan);
  }

  .tool--whatsapp :global(svg) {
    width: 22px;
    height: 22px;
  }

  .tool--lang {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    padding-inline: 0.7rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tool--lang:hover {
    border-color: var(--c-cyan);
  }

  .header-cta {
    display: flex;
    margin-left: 0.4rem;
  }

  .nav-toggle {
    display: none;
  }

  /* Overlay variant: transparent over the hero, solid once the hero has
     scrolled away. The dark glass and the cyan hairline are pseudo-elements:
     a backdrop-filter on the header box itself would make it the containing
     block of the fixed mobile menu panel and collapse that panel. Only
     opacity and transform animate. */
  .site-header--overlay {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header--overlay::before,
  .site-header--overlay::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .site-header--overlay::before {
    inset: 0;
    z-index: -1;
    background: rgba(5, 11, 20, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity var(--motion-dur-fast) var(--ease-out);
  }

  /* Sits exactly on the 1px border row the solid header uses */
  .site-header--overlay::after {
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, rgba(31, 177, 210, 0.6) 0%, rgba(31, 177, 210, 0.25) 45%);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--motion-dur) var(--ease-out);
  }

  .site-header--overlay.is-solid::before {
    opacity: 1;
  }

  .site-header--overlay.is-solid::after {
    transform: scaleX(1);
    transition-delay: 60ms;
  }

  /* First paint (e.g. a reload part-way down the page) snaps into place */
  .site-header--overlay.is-instant::before,
  .site-header--overlay.is-instant::after {
    transition: none;
  }

  :global(.nav-toggle__close) {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] :global(.nav-toggle__open) {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] :global(.nav-toggle__close) {
    display: block;
  }

  @media (max-width: 1240px) {
    .site-nav__link {
      padding: 0 0.6rem;
      font-size: 0.92rem;
      letter-spacing: 0.08em;
    }

    .site-nav__link::after {
      left: 0.6rem;
      right: 0.6rem;
    }
  }

  @media (max-width: 1100px) {
    .header-cta {
      display: none;
    }
  }

  /* Collapse into the full-screen panel */
  @media (max-width: 960px) {
    .header-inner {
      grid-template-columns: auto 1fr;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      z-index: 90;
      justify-self: stretch;
      background: var(--c-ink-950);
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 96px 96px;
      color: #fff;
      padding: var(--s-6) var(--gutter) calc(var(--s-6) + var(--mobile-bar-h));
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility 0s linear var(--dur);
    }

    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      border-top: 1px solid var(--c-line-on-dark);
      counter-reset: nav;
    }

    .site-nav__list li {
      border-bottom: 1px solid var(--c-line-on-dark);
      counter-increment: nav;
    }

    .site-nav__link {
      width: 100%;
      min-height: 60px;
      padding: 0.6rem 0;
      font-size: clamp(1.9rem, 7vw, 2.6rem);
      font-weight: 800;
      letter-spacing: 0.02em;
      color: rgba(255, 255, 255, 0.85);
      gap: 1rem;
    }

    .site-nav__link::before {
      content: counter(nav, decimal-leading-zero);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      color: var(--c-cyan);
    }

    .site-nav__link::after {
      display: none;
    }

    .site-nav__link:hover,
    .site-nav__link.is-current {
      color: #fff;
    }

    .site-nav__extras {
      display: grid;
      gap: var(--s-4);
    }

    .site-nav__whatsapp {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 44px;
      color: #fff;
      font-weight: 600;
    }

    .site-nav__whatsapp :global(svg) {
      width: 22px;
      height: 22px;
      color: var(--c-cyan);
    }

    .site-nav__lang {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--c-on-dark-muted);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .site-nav__lang:hover {
      color: #fff;
    }
  }

  @media (max-width: 480px) {
    .brand__name {
      font-size: 1.1rem;
    }

    .tool--whatsapp {
      display: none; /* the sticky mobile bar carries WhatsApp on phones */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
      transform: none;
    }
  }
</style>
