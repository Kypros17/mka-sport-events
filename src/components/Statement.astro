---
/**
 * Editorial statement on a light grid ground: an oversized outlined numeral
 * and a transparent watermark behind one large sentence, with the audiences
 * as a ruled list alongside.
 */
interface Props {
  index?: string;
  text: string;
  audienceLabel: string;
  audiences: string[];
  watermark?: string;
}

const { index, text, audienceLabel, audiences, watermark } = Astro.props;
---

<section class="statement section section--lg bg-grid--light">
  {watermark && <span class="watermark statement__wm" aria-hidden="true">{watermark}</span>}
  <div class="container container--wide grid-12 statement__grid">
    <div class="statement__main col-8 reveal">
      {index && <span class="giant-num statement__num" aria-hidden="true">{index}</span>}
      <p class="statement__text">{text}</p>
    </div>
    <div class="statement__aside col-4 reveal" data-delay="1">
      <p class="slate">{audienceLabel}</p>
      <ul class="rule-list statement__list">
        {audiences.map((a, i) => (
          <li>
            <span class="statement__li-num">{String(i + 1).padStart(2, "0")}</span>
            {a}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .statement {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--c-line);
  }

  .statement__wm {
    right: -0.02em;
    bottom: -0.15em;
    -webkit-text-stroke-color: rgba(10, 19, 34, 0.08);
  }

  .statement__grid {
    position: relative;
    z-index: 1;
  }

  .statement__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-5);
    align-items: start;
  }

  .statement__num {
    font-size: clamp(4rem, 9vw, 8rem);
    -webkit-text-stroke-color: var(--c-cyan);
    margin-top: 0.05em;
  }

  .statement__text {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--c-ink);
    max-width: 26ch;
    text-wrap: balance;
  }

  .statement__aside {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .statement__list li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-ink);
    padding: 0.55rem 0;
  }

  .statement__li-num {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--c-turq-700);
  }

  @media (max-width: 767px) {
    .statement__main {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }

    .statement__num {
      font-size: 4rem;
    }
  }
</style>
