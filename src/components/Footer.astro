---
/**
 * Footer as in the reference: one compact dark row with the logo and
 * wordmark, the descriptor, the page navigation and social icons, plus a
 * thin second row carrying the contact details, language links and
 * copyright so nothing from the site's contact information is lost.
 */
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import logo from "@/assets/images/logo-mark.png";
import { brandName, contact } from "../../site.config.mjs";
import { getDictionary, localePath, localeNames, locales, type Locale, type RouteKey } from "@/i18n";
import { whatsappLink, telLink, mailLink } from "@/lib/links";

interface Props {
  locale: Locale;
  current: RouteKey;
}

const { locale, current } = Astro.props;
const t = getDictionary(locale);
const year = new Date().getFullYear();

const navItems: { key: RouteKey; label: string }[] = [
  { key: "about", label: t.nav.about },
  { key: "camps", label: t.nav.camps },
  { key: "events", label: t.nav.events },
  { key: "facilities", label: t.nav.facilities },
  { key: "contact", label: t.nav.contact },
];
---

<footer class="site-footer">
  <div class="container container--wide footer-row">
    <a href={localePath(locale, "home")} class="footer-brand" aria-label={`${brandName} — ${t.common.home}`}>
      <Image src={logo} alt="" width="96" height="96" class="footer-brand__mark" loading="lazy" />
      <span class="footer-brand__word" aria-hidden="true">
        <span class="footer-brand__mka">MKA</span>
        <span class="footer-brand__rest"><span class="footer-brand__sport">sport</span> Events</span>
      </span>
    </a>
    <p class="footer-descriptor">{t.footer.descriptor}</p>
    <nav class="footer-nav" aria-label={t.footer.company}>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={localePath(locale, item.key)} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ul class="footer-social" aria-label={t.footer.follow}>
      <li><a href={contact.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a></li>
      <li><a href={contact.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a></li>
      <li><a href={whatsappLink(locale)} target="_blank" rel="noopener" aria-label={t.common.chatOnWhatsapp} data-track="whatsapp"><Icon name="whatsapp" /></a></li>
    </ul>
  </div>

  <div class="container container--wide footer-meta">
    <ul class="footer-contact">
      <li>{t.footer.address}</li>
      {contact.phones.map((p) => (
        <li><a href={telLink(p.e164)} data-track="phone">{p.display}</a></li>
      ))}
      <li><a href={mailLink()} data-track="email">{contact.email}</a></li>
    </ul>
    <ul class="footer-langs">
      {
        locales.map((l) => (
          <li>
            <a href={localePath(l, current)} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined} class:list={{ "is-current": l === locale }}>
              {localeNames[l]}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="footer-copy">© {year} {brandName}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink-950);
    color: rgba(255, 255, 255, 0.78);
    border-top: 1px solid rgba(31, 177, 210, 0.3);
  }

  .footer-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-6);
    min-height: 84px;
    padding-block: var(--s-4);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    color: #fff;
  }

  .footer-brand__mark {
    width: 40px;
    height: 40px;
    border-radius: 4px;
  }

  .footer-brand__word {
    display: grid;
    line-height: 1;
    font-family: var(--font-display);
  }

  .footer-brand__mka {
    font-size: 1.5rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .footer-brand__rest {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-brand__sport {
    color: var(--c-cyan);
  }

  .footer-descriptor {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    transition: color var(--dur) var(--ease);
  }

  .footer-nav a:hover,
  .footer-nav a[aria-current="page"] {
    color: var(--c-cyan);
  }

  .footer-social {
    display: flex;
    gap: 0.3rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #fff;
    transition: color var(--dur) var(--ease);
  }

  .footer-social a:hover {
    color: var(--c-cyan);
  }

  .footer-social :global(svg) {
    width: 20px;
    height: 20px;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--c-line-on-dark);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-contact,
  .footer-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
  }

  .footer-contact a,
  .footer-langs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-contact a:hover,
  .footer-langs a:hover,
  .footer-langs a.is-current {
    color: #fff;
  }

  .footer-langs a.is-current {
    text-decoration: underline;
    text-decoration-color: var(--c-cyan);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 960px) {
    .footer-row {
      grid-template-columns: 1fr auto;
      row-gap: var(--s-3);
    }

    .footer-descriptor {
      grid-column: 1 / -1;
      order: 3;
    }

    .footer-nav {
      grid-column: 1 / -1;
      order: 4;
    }
  }
</style>
