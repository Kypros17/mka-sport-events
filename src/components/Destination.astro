---
/**
 * "03 Your next training camp: Cyprus." as in the reference: photograph on
 * the left with the italic headline over a dark overlay and a diagonal edge;
 * a light panel on the right with four icon benefits in a row, the
 * underlined link, the outline map with markers and a small tagline.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Place {
  name: string;
  /** Must match a key of `markers` below; JSON dictionaries type it as string. */
  key: string;
}

interface Benefit {
  title: string;
  text: string;
}

interface Props {
  index: string;
  label: string;
  display: string[];
  benefits: Benefit[];
  cta: string;
  href: string;
  places: Place[];
  mapLabel: string;
  tagline: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { index, label, display, benefits, cta, href, places, mapLabel, tagline, image, imageAlt } = Astro.props;
const icons = ["sun", "plane", "pin", "stadium"] as const;

// Cyprus coastline from Natural Earth 1:10m land (public domain), whole island,
// no internal lines; equirectangular projection scaled by cos(35.1°) into the
// 610×380 viewBox. Towns are placed at their real coordinates.
const coast =
  "M580.4,24.2 L592.0,20.1 L589.3,23.2 L587.5,34.9 L579.5,36.4 L554.6,52.8 L533.2,71.7 L479.7,103.9 L472.6,110.0 L467.2,117.7 L460.1,131.5 L456.5,134.0 L450.3,134.6 L438.7,132.5 L433.3,135.1 L423.5,150.9 L420.9,179.5 L424.4,182.1 L434.2,192.3 L440.5,203.0 L454.7,215.3 L458.3,219.4 L463.7,233.2 L469.9,239.8 L460.1,239.8 L453.8,237.8 L448.5,233.2 L435.1,235.2 L423.5,238.3 L420.9,239.8 L414.6,247.5 L412.0,248.5 L407.5,247.0 L401.3,240.3 L396.8,237.8 L386.1,235.7 L375.4,236.2 L366.5,239.8 L360.3,246.5 L358.5,250.0 L354.9,260.3 L354.9,274.1 L350.5,276.1 L349.6,281.7 L347.8,283.3 L344.2,284.8 L332.6,285.3 L325.5,294.5 L313.9,297.6 L306.8,301.1 L300.5,302.7 L297.0,298.1 L297.0,306.8 L289.8,310.8 L271.1,314.9 L262.2,320.0 L258.7,321.1 L240.8,318.5 L219.4,322.1 L215.9,324.1 L204.3,334.9 L201.6,340.0 L200.7,343.0 L200.7,351.2 L205.2,358.4 L205.2,359.9 L183.8,359.9 L184.7,352.2 L177.5,338.4 L176.7,333.3 L157.0,329.2 L151.7,329.8 L135.7,335.4 L125.8,336.9 L115.2,334.9 L88.4,320.6 L83.1,319.0 L72.4,318.0 L67.9,316.5 L52.8,304.2 L50.1,294.0 L50.1,290.9 L44.7,275.1 L34.0,266.9 L30.5,260.3 L30.5,256.2 L32.3,252.6 L26.9,241.4 L26.0,229.1 L18.9,215.3 L18.0,207.6 L18.9,202.0 L21.6,200.0 L26.9,203.5 L37.6,214.8 L43.0,216.8 L52.8,216.3 L61.7,211.7 L69.7,204.6 L75.0,196.4 L81.3,182.1 L87.5,175.4 L92.9,178.0 L103.6,173.4 L111.6,172.4 L134.8,175.4 L142.8,178.0 L149.0,182.1 L155.3,184.6 L165.1,182.1 L171.3,176.5 L176.7,168.8 L180.2,159.1 L182.0,147.8 L182.0,127.4 L181.1,118.7 L178.4,109.0 L184.7,110.0 L194.5,116.2 L215.0,120.8 L232.8,119.7 L263.1,123.8 L267.6,125.9 L304.1,130.0 L361.2,120.8 L392.3,103.4 L404.8,105.4 L418.2,101.3 L454.7,87.0 L464.5,79.9 L477.9,74.8 L490.4,62.0 L525.2,52.3 L535.0,45.6 L580.4,24.2 Z";

const markers: Record<string, { x: number; y: number; anchor: "start" | "end"; dx: number; dy: number }> = {
  nicosia: { x: 293, y: 173, anchor: "start", dx: 14, dy: -8 },
  "agia-napa": { x: 445, y: 235, anchor: "start", dx: 8, dy: 22 },
  larnaca: { x: 352, y: 253, anchor: "start", dx: 14, dy: 20 },
  limassol: { x: 208, y: 318, anchor: "end", dx: -14, dy: 6 },
  paphos: { x: 56, y: 297, anchor: "end", dx: -14, dy: 4 },
};

const missing = places.filter((p) => !(p.key in markers)).map((p) => p.key);
if (missing.length > 0) {
  throw new Error(`Destination: no map marker for place key(s) ${missing.join(", ")}`);
}
---

<section class="destination">
  <div class="destination__photo">
    <div class="destination__media" aria-hidden="true" data-reveal="image">
      <Picture
        src={image}
        alt=""
        widths={[640, 960, 1280].filter((w) => w <= image.width)}
        sizes="(min-width: 1024px) 50vw, 100vw"
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        loading="lazy"
        decoding="async"
      />
    </div>
    <p class="sr-only">{imageAlt}</p>
    <div class="destination__copy" data-stagger="tight">
      <p class="slate on-dark destination__slate" data-motion="rise"><span class="slate__num">{index}</span>{label}</p>
      <h2 class="destination__title display display--it">
        {display.map((line, i) => (
          <span class:list={[{ display__accent: i === display.length - 1 }]} data-motion="rise">{line}</span>
        ))}
      </h2>
    </div>
  </div>

  <div class="destination__panel">
    <div class="destination__panel-inner">
      <ul class="destination__benefits" data-stagger="tight" data-motion-delay="80">
        {
          benefits.map((b, i) => (
            <li class="benefit" data-motion="rise">
              <span class="benefit__icon"><Icon name={icons[i]} /></span>
              <span class="benefit__title">{b.title}</span>
              <span class="benefit__text">{b.text}</span>
            </li>
          ))
        }
      </ul>
      <a href={href} class="ul-link destination__cta" data-motion="rise" data-motion-delay="240">
        {cta}
        <Icon name="arrow" />
      </a>
      <div class="destination__map" data-motion="rise" data-motion-delay="160">
        <svg viewBox="0 0 610 380" role="img" aria-label={mapLabel} class="map">
          <path d={coast} class="map__coast" />
          {
            places.map((p) => {
              const m = markers[p.key];
              return (
                <g>
                  <circle cx={m.x} cy={m.y} r="6" class="map__dot" />
                  <text x={m.x + m.dx} y={m.y + m.dy} text-anchor={m.anchor} class="map__label">
                    {p.name}
                  </text>
                </g>
              );
            })
          }
        </svg>
        <p class="destination__tagline">{tagline}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .destination {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
    background: var(--c-panel-light);
    min-height: clamp(380px, 32vw, 460px);
    overflow: hidden;
  }

  .destination__photo {
    position: relative;
    display: grid;
    align-items: center;
    color: #fff;
    isolation: isolate;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
    margin-right: -10%;
    z-index: 1;
  }

  .destination__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-navy-800);
  }

  .destination__media :global(picture),
  .destination__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .destination__media :global(img) {
    object-fit: cover;
    object-position: 55% 15%;
    filter: saturate(1.15);
  }

  .destination__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 11, 20, 0.9) 0%, rgba(5, 11, 20, 0.6) 45%, rgba(5, 11, 20, 0.2) 100%),
      linear-gradient(180deg, rgba(5, 11, 20, 0.2), rgba(5, 11, 20, 0.5));
  }

  .destination__copy {
    display: grid;
    gap: var(--s-3);
    padding: var(--home-y) 12% var(--home-y) max(var(--gutter), calc((100vw - var(--container-wide)) / 2));
  }

  .destination__slate::after {
    display: none;
  }

  .destination__title {
    display: grid;
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    line-height: 0.92;
    color: #fff;
    padding-right: 0.15em;
  }

  .destination__title span {
    display: block;
  }

  .destination__panel {
    display: grid;
    align-items: center;
    padding: var(--home-y) max(var(--gutter), calc((100vw - var(--container-wide)) / 2)) var(--home-y) clamp(1.5rem, 4vw, 4rem);
  }

  .destination__panel-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    row-gap: var(--s-4);
    align-items: center;
  }

  .destination__benefits {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .benefit {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .benefit__icon {
    color: var(--c-turq-700);
    margin-bottom: 0.4rem;
  }

  .benefit__icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .benefit__title {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink);
    line-height: 1.2;
  }

  .benefit__text {
    font-size: 0.78rem;
    color: var(--c-muted);
    line-height: 1.4;
  }

  .destination__cta {
    grid-column: 1;
    grid-row: 2;
    width: fit-content;
  }

  .destination__map {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    gap: 0.4rem;
    justify-items: end;
  }

  .map {
    width: 100%;
    max-width: 22rem;
    height: auto;
    overflow: visible;
  }

  .map__coast {
    fill: rgba(31, 177, 210, 0.06);
    stroke: var(--c-navy-700);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .map__dot {
    fill: var(--c-cyan);
    stroke: #fff;
    stroke-width: 2;
  }

  .map__label {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--c-ink);
  }

  .destination__tagline {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    color: var(--c-muted);
    line-height: 1.5;
    max-width: 12ch;
  }

  @media (max-width: 1100px) {
    .destination__benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .destination {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .destination__photo {
      clip-path: polygon(0 0, 100% 0, 100% 86%, 0 100%);
      margin-right: 0;
      min-height: 52vw;
    }

    .destination__copy {
      padding: calc(var(--home-y) + 2rem) var(--gutter) calc(var(--home-y) + 2rem);
    }

    .destination__panel {
      padding: var(--s-5) var(--gutter) var(--home-y);
    }

    .destination__panel-inner {
      grid-template-columns: 1fr;
    }

    .destination__map {
      grid-column: 1;
      grid-row: auto;
      justify-items: start;
    }

    .destination__cta {
      grid-row: auto;
    }

    .destination__tagline {
      text-align: left;
      max-width: none;
    }
  }
</style>
