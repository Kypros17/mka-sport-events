---
/**
 * "01 Who we are" as in the reference: brand name as the italic display
 * title, a tracked uppercase subtitle, one paragraph and an underlined link;
 * a monochrome parallelogram photograph in the centre with the handwritten
 * "Cyprus" overlapping its right edge; the "We work with" list on the right.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import Streaks from "./Streaks.astro";

interface Props {
  index: string;
  label: string;
  brand: string;
  title: string;
  text: string;
  cta: string;
  href: string;
  script: string;
  image: ImageMetadata;
  imageAlt: string;
  workLabel: string;
  audiences: string[];
}

const { index, label, brand, title, text, cta, href, script, image, imageAlt, workLabel, audiences } = Astro.props;
---

<section class="who">
  <Streaks side="right" soft />
  <div class="container container--wide who__grid">
    <div class="who__copy reveal">
      <p class="slate"><span class="slate__num">{index}</span>{label}</p>
      <h2 class="who__title display--it">{brand}</h2>
      <p class="who__sub">{title}</p>
      <p class="who__text">{text}</p>
      <a href={href} class="ul-link">{cta}<Icon name="arrow" /></a>
    </div>

    <div class="who__media reveal" data-delay="1">
      <div class="who__photo para" data-reveal="image" data-motion-delay="80">
        <Picture
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1200].filter((w) => w <= image.width)}
          sizes="(min-width: 1024px) 44vw, 100vw"
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="script who__script" aria-hidden="true">{script}</span>
    </div>

    <div class="who__aside reveal" data-delay="2">
      <p class="who__aside-label">{workLabel}</p>
      <ol class="who__list">
        {audiences.map((a) => <li>{a}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .who {
    position: relative;
    background: var(--c-bg);
    padding-block: var(--home-y);
    overflow: hidden;
  }

  .who__grid {
    display: grid;
    grid-template-columns: minmax(0, 4.2fr) minmax(0, 5fr) minmax(0, 2.4fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }

  .who__copy {
    display: grid;
    gap: 0.6rem;
    align-content: center;
  }

  .who__copy .slate {
    margin-bottom: 0.4rem;
  }

  .who__copy .slate::after {
    display: none;
  }

  .who__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
    line-height: 0.95;
    color: var(--c-ink);
  }

  .who__sub {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-navy-700);
  }

  .who__text {
    margin-top: 0.6rem;
    color: var(--c-text);
    max-width: 40ch;
  }

  .who__copy .ul-link {
    margin-top: 0.4rem;
  }

  .who__media {
    position: relative;
  }

  .who__photo {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-navy-800);
  }

  .who__photo :global(picture),
  .who__photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .who__photo :global(img) {
    object-fit: cover;
    object-position: 45% 50%;
    filter: grayscale(1) contrast(1.08);
  }

  .who__script {
    position: absolute;
    right: -0.15em;
    bottom: -0.12em;
    z-index: 2;
    font-size: clamp(3rem, 6vw, 5.5rem);
    text-shadow: 0 2px 14px rgba(5, 11, 20, 0.35);
  }

  .who__aside {
    display: grid;
    gap: var(--s-3);
    align-content: center;
  }

  .who__aside-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-ink);
  }

  .who__list li {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--c-ink);
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--c-line-strong);
  }

  @media (max-width: 1100px) {
    .who__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .who__media {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .who__aside {
      grid-column: 1;
    }
  }

  @media (max-width: 767px) {
    .who__grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }

    .who__media {
      grid-column: auto;
      grid-row: auto;
      margin-bottom: var(--s-4);
    }

    .who__aside {
      grid-column: auto;
    }

    .who__photo {
      clip-path: polygon(0 0, 100% 0, 94% 100%, 0 100%);
    }

    .who__script {
      font-size: 3.2rem;
      right: 0.2em;
    }

    .who__list {
      columns: 2;
      column-gap: var(--s-5);
    }
  }
</style>
