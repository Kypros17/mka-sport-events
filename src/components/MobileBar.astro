---
/**
 * Sticky bottom bar on phones: WhatsApp and Request an Offer, the two
 * actions that matter most for this audience. Hidden on the contact page,
 * where the form itself is the action.
 */
import Icon from "./Icon.astro";
import { getDictionary, localePath, type Locale } from "@/i18n";
import { whatsappLink } from "@/lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<div class="mobile-bar" aria-label={t.nav.contact}>
  <a class="mobile-bar__btn mobile-bar__btn--whatsapp" href={whatsappLink(locale)} target="_blank" rel="noopener" data-track="whatsapp">
    <Icon name="whatsapp" />
    <span>{t.mobileBar.whatsapp}</span>
  </a>
  <a class="mobile-bar__btn mobile-bar__btn--offer" href={localePath(locale, "contact")} data-track="offer">
    <span>{t.mobileBar.offer}</span>
    <Icon name="arrow" />
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 1px;
      background: var(--c-line-strong);
      border-top: 1px solid var(--c-line-strong);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .mobile-bar__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: var(--mobile-bar-h);
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .mobile-bar__btn svg {
      width: 20px;
      height: 20px;
    }

    .mobile-bar__btn--whatsapp {
      background: #fff;
      color: var(--c-navy-900);
    }

    .mobile-bar__btn--whatsapp svg {
      color: var(--c-turq-700);
    }

    .mobile-bar__btn--offer {
      background: var(--c-red);
      color: #fff;
    }
  }
</style>
