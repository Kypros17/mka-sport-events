---
/**
 * Founder block: name, roles kept visibly separate, one paragraph, and a
 * portrait slot. Until a confirmed photograph exists the slot is a designed
 * monogram panel: MKA mark on near-black with rings and a hairline frame.
 * Pass `image` to replace it. Never a generated face.
 */
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
import logo from "@/assets/images/logo-mark.png";

interface Props {
  index?: string;
  kicker: string;
  name: string;
  roles: string[];
  text: string;
  cta: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { index, kicker, name, roles, text, cta, href, image, imageAlt = "" } = Astro.props;
---

<section class="section section--lg founder bg-grid--light">
  <div class="container container--wide grid-12 founder__grid">
    <div class="col-4 founder__portrait reveal">
      {
        image ? (
          <div class="frame frame--portrait corners grade">
            <Picture
              src={image}
              alt={imageAlt}
              widths={[480, 720, 960].filter((w) => w <= image.width)}
              sizes="(min-width: 1024px) 420px, 100vw"
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : (
          <div class="founder__mark cut-br bg-grid" aria-hidden="true">
            <span class="ring founder__ring founder__ring--a" />
            <span class="ring founder__ring founder__ring--b" />
            <Image src={logo} alt="" width="192" height="192" class="founder__mark-img" loading="lazy" />
            <span class="founder__mark-word">MKA</span>
          </div>
        )
      }
    </div>
    <div class="col-7 col-start-6 founder__body reveal" data-delay="1">
      <p class="slate">
        {index && <span class="slate__num">{index}</span>}
        {kicker}
      </p>
      <h2 class="founder__name display">{name}</h2>
      <ul class="rule-list founder__roles">
        {roles.map((r, i) => (
          <li>
            <span class="founder__role-num">{String(i + 1).padStart(2, "0")}</span>
            {r}
          </li>
        ))}
      </ul>
      <p class="founder__text">{text}</p>
      <a href={href} class="arrow-link">
        {cta}
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .founder {
    border-top: 1px solid var(--c-line);
  }

  .founder__grid {
    align-items: center;
  }

  .founder__mark {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    background-color: var(--c-ink-950);
    overflow: hidden;
  }

  .founder__ring--a {
    width: 120%;
    aspect-ratio: 1;
    left: -35%;
    top: -20%;
  }

  .founder__ring--b {
    width: 70%;
    aspect-ratio: 1;
    right: -25%;
    bottom: -20%;
    border-width: 2px;
  }

  .founder__mark-img {
    width: 34%;
    height: auto;
    border-radius: 6px;
    position: relative;
    z-index: 1;
  }

  .founder__mark-word {
    position: absolute;
    left: -0.04em;
    bottom: -0.15em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 14vw, 11rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgba(31, 177, 210, 0.35);
  }

  .founder__body {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .founder__name {
    font-size: clamp(3rem, 7vw, 6.4rem);
  }

  .founder__roles li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-navy-700);
    padding: 0.7rem 0;
  }

  .founder__role-num {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--c-turq-700);
  }

  .founder__text {
    color: var(--c-muted);
    max-width: 58ch;
  }

  @media (max-width: 860px) {
    .founder__portrait {
      max-width: 20rem;
    }
  }
</style>
