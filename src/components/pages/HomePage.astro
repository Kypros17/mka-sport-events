---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/HomeHero.astro";
import WhoWeAre from "@/components/WhoWeAre.astro";
import ServicePanels from "@/components/ServicePanels.astro";
import Destination from "@/components/Destination.astro";
import PackageBand from "@/components/PackageBand.astro";
import PhotoRow from "@/components/PhotoRow.astro";
import CtaBand from "@/components/CtaBand.astro";
import Streaks from "@/components/Streaks.astro";
import { getDictionary, localePath, type Locale } from "@/i18n";
import heroImg from "@/assets/images/camp-football-1.jpeg";
import whoImg from "@/assets/images/camp-banner-2.jpeg";
import cardCamps from "@/assets/images/camp-football-3.jpeg";
import cardEvents from "@/assets/images/camp-football-2.jpeg";
import cardOrg from "@/assets/images/camp-banner-1.jpeg";
import cyprusImg from "@/assets/images/camp-banner-1.jpeg";
import packageImg from "@/assets/images/camp-team-1.jpeg";
import ctaBg from "@/assets/images/camp-football-2.jpeg";
import ctaSide from "@/assets/images/camp-football-3.jpeg";
import p1 from "@/assets/images/camp-team-1.jpeg";
import p2 from "@/assets/images/camp-banner-2.jpeg";
import p3 from "@/assets/images/camp-football-2.jpeg";
import p4 from "@/assets/images/camp-banner-1.jpeg";
import p5 from "@/assets/images/camp-football-3.jpeg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const h = t.home;

const cards = [
  { ...h.serviceCards[0], href: localePath(locale, "camps"), image: cardCamps, position: "50% 40%" },
  { ...h.serviceCards[1], href: localePath(locale, "events"), image: cardEvents, position: "45% 40%" },
  { ...h.serviceCards[2], href: localePath(locale, "events"), image: cardOrg, position: "22% 50%" },
];

const gallery = [p1, p2, p3, p4, p5].map((image, i) => ({ image, alt: h.proof.items[i].alt }));
---

<BaseLayout
  locale={locale}
  current="home"
  title={h.seo.title}
  description={h.seo.description}
  ogImage={heroImg}
  ogImageAlt={h.hero.imageAlt}
  headerVariant="overlay"
>
  <HomeHero locale={locale} />

  <!-- 01 Who we are -->
  <WhoWeAre
    index="01"
    label={h.who.label}
    brand={h.who.brand}
    title={h.who.title}
    text={h.who.text}
    cta={h.who.cta}
    href={localePath(locale, "about")}
    script={h.who.script}
    image={whoImg}
    imageAlt={h.who.imageAlt}
    workLabel={h.who.workLabel}
    audiences={h.who.audiences}
  />

  <!-- 02 Our services -->
  <section class="services" id="services">
    <Streaks side="left" soft />
    <div class="container container--wide services__grid">
      <div class="services__head reveal">
        <p class="slate on-dark services__slate"><span class="slate__num">02</span>{h.servicesHead.label}</p>
        <h2 class="services__title display display--it">
          {h.servicesHead.lines.map((line) => <span>{line}</span>)}
        </h2>
      </div>
      <ServicePanels cards={cards} />
    </div>
  </section>

  <!-- 03 Cyprus -->
  <Destination
    index="03"
    label={h.cyprus.label}
    display={h.cyprus.display}
    benefits={h.cyprus.benefits}
    cta={h.cyprus.cta}
    href={localePath(locale, "facilities")}
    places={h.cyprus.places}
    mapLabel={h.cyprus.mapLabel}
    tagline={h.cyprus.tagline}
    image={cyprusImg}
    imageAlt={h.cyprus.imageAlt}
  />

  <!-- 04 Training camps -->
  <PackageBand
    locale={locale}
    index="04"
    label={h.package.label}
    from={h.package.from}
    price={h.package.price}
    indicative={h.package.indicative}
    meta={h.package.meta}
    cta={h.package.cta}
    includedTitle={h.package.includedTitle}
    included={h.package.included}
    tagline={h.package.tagline}
    image={packageImg}
    imageAlt={h.package.imageAlt}
  />

  <!-- Real experiences -->
  <PhotoRow label={h.proof.label} title={h.proof.title} note={h.proof.text} items={gallery} regionLabel={h.proof.stripLabel} />

  <!-- Final CTA -->
  <CtaBand
    locale={locale}
    title={h.finalCta.title}
    text={h.finalCta.text}
    showContacts
    contactsLabel={h.finalCta.contactsLabel}
    image={ctaBg}
    imageAlt={h.proof.items[2].alt}
    sideImage={ctaSide}
    sideImageAlt={h.serviceCards[0].alt}
    script={h.finalCta.script}
  />
</BaseLayout>

<style>
  .services {
    position: relative;
    background: var(--c-navy-900);
    color: #fff;
    overflow: hidden;
    padding-block: var(--home-y);
  }

  .services__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }

  .services__head {
    display: grid;
    gap: var(--s-3);
    align-content: center;
  }

  .services__slate::after {
    display: none;
  }

  .services__title {
    display: grid;
    font-size: clamp(2.2rem, 3.6vw, 3.4rem);
    line-height: 0.92;
    color: #fff;
    padding-right: 0.15em;
  }

  .services__title span {
    display: block;
  }

  @media (max-width: 1100px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
