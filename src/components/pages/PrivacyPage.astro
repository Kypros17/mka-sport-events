---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { contact } from "../../../site.config.mjs";
import { getDictionary, type Locale } from "@/i18n";
import { mailLink } from "@/lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const p = t.privacy;
---

<BaseLayout locale={locale} current="privacy" title={p.seo.title} description={p.seo.description}>
  <PageHero kicker={p.hero.kicker} title={p.hero.title} text={p.hero.text} />

  <section class="section">
    <div class="container container--narrow privacy">
      <p class="privacy__updated">{p.updatedLabel}: {p.updated}</p>
      {
        p.sections.map((s) => (
          <section class="privacy__block">
            <h2 class="privacy__title">{s.title}</h2>
            {s.paragraphs.map((para) => <p>{para}</p>)}
          </section>
        ))
      }
      <p class="privacy__contact">
        {p.contactLabel}: <a href={mailLink()} data-track="email">{contact.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy {
    display: grid;
    gap: var(--s-6);
  }

  .privacy__updated {
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .privacy__block {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
  }

  .privacy__title {
    font-size: var(--fs-h3);
  }

  .privacy__block p {
    color: var(--c-text);
    max-width: 68ch;
  }

  .privacy__contact a {
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
