---
/**
 * Accessible FAQ built on native <details>/<summary>: keyboard support and
 * no JavaScript. Emits FAQPage JSON-LD through the `schema` slot of the page.
 */
import Icon from "./Icon.astro";

interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item reveal" name="faq">
        <summary class="faq__q">
          <span class="faq__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="faq__text">{item.q}</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--c-line);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line);
  }

  .faq__q {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    min-height: 44px;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 600;
    color: var(--c-ink);
    transition: color var(--dur) var(--ease);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--c-turq-700);
  }

  .faq__num {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--c-turq-700);
  }

  :global(.faq__icon) {
    width: 22px;
    height: 22px;
    color: var(--c-muted);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 0 1.4rem calc(var(--s-4) + 2.2rem);
    max-width: 68ch;
    color: var(--c-muted);
  }

  @media (max-width: 560px) {
    .faq__a {
      padding-left: 0;
    }
  }
</style>
