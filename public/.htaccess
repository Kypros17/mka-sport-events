# MKA sport Events — Apache/LiteSpeed configuration for shared hosting.
# The site is fully static; these rules add clean-URL redirects for the
# retired .html addresses, security headers, caching and compression.
# Every module-specific block is wrapped in <IfModule> so the site still
# serves on hosting where a module is missing.

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block dotfiles and dot-directories, except /.well-known/, which the host
  # needs for SSL certificate issuing and renewal (ACME challenges).
  RewriteRule (^|/)\.(?!well-known/) - [F]

  # Redirect the old file-based URLs to the new directory URLs (301)
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^about\.html$ /about/ [R=301,L]
  RewriteRule ^camps\.html$ /training-camps/ [R=301,L]
  RewriteRule ^events\.html$ /events/ [R=301,L]
  RewriteRule ^facilities\.html$ /facilities/ [R=301,L]
  RewriteRule ^contact\.html$ /contact/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Pages: always revalidate, so content changes show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Fixed-name files (favicons, icons, manifest, sitemap, robots, images in
  # public/): one day, so a replaced favicon or icon reaches visitors quickly.
  # Fingerprinted build assets in /assets/ get a year — see assets/.htaccess.
  <FilesMatch "\.(png|jpe?g|svg|ico|webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Fallback when mod_headers is unavailable: same policy through mod_expires.
<IfModule !mod_headers.c>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    ExpiresByType text/html "access plus 0 seconds"
  </IfModule>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Serve the custom 404 page
ErrorDocument 404 /404.html
